rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        ((request.auth.token.keys().hasAny(['admin']) &&
          request.auth.token.admin == true) ||
         (request.auth.token.keys().hasAny(['role']) &&
          request.auth.token.role == 'admin'));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
    match /orderRequests/{requestId} {
      allow read, write: if false;
    }
    match /counters/{counterId} {
      allow read, write: if false;
    }
    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read: if isAdmin() || (resource.data.isActive == true && resource.data.stockStatus != 'hidden');
      allow write: if isAdmin();
    }
    match /locations/{locationId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }
    match /productPrices/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
