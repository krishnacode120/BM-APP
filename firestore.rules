rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        ((request.auth.token.keys().hasAny(['admin']) &&
          request.auth.token.admin == true) ||
         (request.auth.token.keys().hasAny(['role']) &&
          request.auth.token.role == 'admin'));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId &&
        request.auth.token.keys().hasAny(['phone_number']) &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'customer' &&
        request.resource.data.phoneVerified == true &&
        request.resource.data.isActive == true &&
        request.resource.data.phoneNumber == request.auth.token.phone_number &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'phoneNumber', 'role', 'phoneVerified', 'isActive',
          'createdAt', 'updatedAt'
        ]);
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId &&
         resource.data.role == 'customer' &&
         resource.data.phoneVerified == true &&
         resource.data.isActive == true &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'updatedAt']));
      allow delete: if false;
    }
    match /users/{userId}/devices/{deviceId} {
      // FCM tokens are registered/deactivated only by authenticated callables.
      // They are never readable by customers or the normal admin UI.
      allow read, write: if false;
    }
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
    match /orderRequests/{requestId} {
      allow read, write: if false;
    }
    match /counters/{counterId} {
      allow read, write: if false;
    }
    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read: if isAdmin() || (resource.data.isActive == true && resource.data.stockStatus != 'hidden');
      allow write: if isAdmin();
    }
    match /locations/{locationId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }
    match /productPrices/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /settings/app {
      // Customer-facing contact data only. Secrets never belong here.
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notificationJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /notificationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /reportSyncJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /reportSyncState/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
